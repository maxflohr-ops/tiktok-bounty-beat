# Whop — server-only secrets. NEVER add a VITE_ prefix to any of these.
WHOP_APP_ID=
WHOP_APP_API_KEY=            # server only: user identity, experience scoping, notifications
WHOP_ACCOUNT_API_KEY=        # server only: platform account, money
WHOP_PLATFORM_ACCOUNT_ID=    # biz_...
WHOP_WEBHOOK_SECRET=
WHOP_API_VERSION_DATE=       # pin to the latest dated version in the OpenAPI spec
WHOP_SANDBOX=true            # sandbox-api.whop.com until go-live

# Public — the ONLY Whop value allowed in the client bundle.
VITE_WHOP_APP_ID=

# Money safety rails
DRY_RUN=true                 # every money call writes intent to whop_outbox and stops
MIRROR_WHOP_BOUNTIES=false   # never mirror contracts into Whop native bounties
PLATFORM_COVERS_PAYOUT_FEES=true

# Existing integrations (values live in the deployment env, not in git)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # server only
STRIPE_SECRET_KEY=           # server only
STRIPE_WEBHOOK_SECRET=       # server only
BRIDGE_SHARED_SECRET=        # server only, HMAC with the Replit verification worker
COPULA_BASE_URL=
